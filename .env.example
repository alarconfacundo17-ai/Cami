# Copiar este archivo a ".env" y completar con los datos de tu proyecto de
# Supabase (Project Settings → API). Sin esto, el sitio funciona igual pero
# con el contenido estático de src/content.js, y el panel /admin no sirve.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY
